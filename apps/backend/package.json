{
    "name": "@weighme/backend",
    "version": "0.0.0",
    "private": true,
    "description": "Backend: HTTP API (Hono) over a SQLite store of measured packages, and the queue the worker takes jobs from",
    "type": "module",
    "scripts": {
        "dev": "tsdown --watch --on-success \"node --env-file-if-exists=.env dist/main.api.mjs\"",
        "build": "tsdown",
        "start": "node --env-file-if-exists=.env dist/main.api.mjs",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@hono/node-server": "2.1.6",
        "@modelcontextprotocol/server": "2.4.0",
        "@weighme/core": "workspace:*",
        "hono": "4.13.16",
        "ip-address": "10.7.4",
        "pino": "10.4.0",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@modelcontextprotocol/client": "2.4.0",
        "@types/node": "26.6.4",
        "tsdown": "0.23.0",
        "vitest": "5.0.3"
    }
}
