{
    "name": "weighme",
    "version": "0.0.0",
    "private": true,
    "description": "Free, open tool that shows what an npm package really costs your bundle",
    "homepage": "https://github.com/janszotkowski/weighme#readme",
    "bugs": {
        "url": "https://github.com/janszotkowski/weighme/issues"
    },
    "license": "MIT",
    "author": "Jan Szotkowski",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/janszotkowski/weighme.git"
    },
    "type": "module",
    "scripts": {
        "env:init": "node tools/init-env.js",
        "build": "turbo run build",
        "dev": "node tools/init-env.js && docker compose up --detach --build worker && turbo run dev",
        "worker:logs": "docker compose logs --follow worker",
        "worker:stop": "docker compose stop worker registry-gateway",
        "worker:clean": "docker compose down --volumes",
        "start": "turbo run start",
        "lint": "oxlint --deny-warnings",
        "lint:fix": "oxlint --fix",
        "typecheck": "turbo run typecheck",
        "test": "turbo run test",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "policy": "node tools/check-policy.js",
        "smoke": "node tools/smoke.js",
        "e2e": "pnpm --filter @weighme/e2e test:e2e",
        "stack": "docker compose --profile app up --build",
        "stack:down": "docker compose --profile app down",
        "verify": "pnpm policy && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm smoke"
    },
    "devDependencies": {
        "oxfmt": "0.75.0",
        "oxlint": "1.90.0",
        "turbo": "2.11.10",
        "typescript": "7.0.2"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.14.0",
            "onFail": "download"
        },
        "runtime": {
            "name": "node",
            "version": "24.22.2",
            "onFail": "error"
        }
    },
    "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
